# Server
PORT=5000
NODE_ENV=production
APP_URL=https://api.example.com

# Web origins allowed to call the backend
FRONTEND_URLS=https://glam.nemnidhi.com,http://localhost:5173

# Optional override if your frontend build is not in ../frontend/dist
FRONTEND_DIST_DIR=../frontend/dist

# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/

# JWT
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=1d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email / auth providers
RESEND_API_KEY=re_xxxxx
GOOGLE_CLIENT_ID=your-google-client-id

# Payments
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me
